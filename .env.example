# Copy to .env (never commit .env). Only variables actually read by backend/config.py are listed.
# docker compose refuses to start without POSTGRES_PASSWORD, SECRET_KEY and GRAFANA_PASSWORD.
# Run ./scripts/init_env.sh to create .env with random values; the placeholders below are not usable.

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# DEBUG=true creates the database tables at startup (no migrations are shipped yet).
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=siem_db
POSTGRES_USER=siem_user
POSTGRES_PASSWORD=__GENERATE_WITH_scripts/init_env.sh__

# Redis (connectivity probe only for now)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SECRET_KEY=__GENERATE_WITH_scripts/init_env.sh__
GRAFANA_PASSWORD=__GENERATE_WITH_scripts/init_env.sh__

# Model
# Directory (latest ensemble_*.joblib is loaded) or a single file.
# `make reproduce` writes the evaluated model here; `make demo-model` writes a synthetic one.
MODEL_PATH=./models
MODEL_CONTAMINATION=0.03
MODEL_N_ESTIMATORS=100
DBSCAN_EPS=1.5
DBSCAN_MIN_SAMPLES=50
GMM_N_COMPONENTS=3
# Isolation Forest only. DBSCAN/GMM are opt-in (e.g. 0.5,0.3,0.2); see results/report.md
ENSEMBLE_WEIGHTS=1.0,0.0,0.0

# Alert levels applied to the ensemble risk score. These are heuristics, not calibrated
# thresholds; see README "Limitations".
ALERT_THRESHOLD_HIGH=0.8
ALERT_THRESHOLD_MEDIUM=0.6
ALERT_THRESHOLD_LOW=0.4

PROMETHEUS_ENABLED=true

# Evaluation (make reproduce): where the public dataset is stored. Keep it outside cloud-synced folders.
SIEM_DATA_DIR=/home/YOU/datasets/siem-anomaly
